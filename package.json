{
  "name": "lossless-player",
  "private": true,
  "version": "0.1.0",
  "description": "Offline Windows desktop lossless audio player built with Electron, React, TypeScript, and SQLite.",
  "author": "Lossless Player",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "electron-vite dev",
    "dev:ui": "vite --config vite.config.ts --port=3000 --host=0.0.0.0",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --win",
    "dist:nsis": "electron-vite build && electron-builder --win nsis",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf out dist release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^0.546.0",
    "music-metadata": "^12.8.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
