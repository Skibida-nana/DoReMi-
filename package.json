{
  "name": "lossless-player",
  "private": true,
  "version": "1.0.0-rc.2",
  "description": "Offline Windows desktop lossless audio player built with Electron, React, TypeScript, and SQLite.",
  "author": "kamisamao",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "node scripts/ensure-electron.mjs && electron-vite dev",
    "dev:ui": "vite --config vite.config.ts --port=3000 --host=0.0.0.0",
    "build": "electron-vite build && node scripts/verify-build.mjs",
    "preview": "node scripts/ensure-electron.mjs && electron-vite preview",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "codecs:verify": "node scripts/verify-codecs.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "doctor": "node scripts/doctor.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && node scripts/ensure-electron.mjs && electron-builder --win",
    "dist:nsis": "npm run build && node scripts/ensure-electron.mjs && electron-builder --win nsis",
    "dist:portable": "npm run build && node scripts/ensure-electron.mjs && electron-builder --win portable",
    "test": "node scripts/run-tests-node.mjs",
    "test:electron": "node scripts/run-tests-electron.mjs",
    "docs:sync": "node scripts/sync-user-guide.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@mgz-dev/alac": "^0.1.1",
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^0.546.0",
    "music-metadata": "^12.8.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
